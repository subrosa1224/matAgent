# Copy this file to .env and fill in the values needed by your deployment.
# .env is ignored by Git. Never commit real credentials.

# Materials Project is required for live materials-database queries.
MP_API_KEY=
OPENALEX_MAILTO=
S2_API_KEY=

# The same password must be used in the Compose database and its URL below.
# Use a strong URL-safe password, or percent-encode special characters in the URL.
MATAGENT_POSTGRES_PASSWORD=
MATAGENT_POSTGRES_USER=matagent
MATAGENT_POSTGRES_DB=matagent
MATAGENT_POSTGRES_PORT=5432
LITERATURE_DATABASE_URL=
# On Linux use an absolute path, for example /home/ubuntu/matAgent/data/literature_pdfs.
# Multiple paths are separated by ':' on Linux and ';' on Windows.
LITERATURE_INGEST_ROOTS=
LITERATURE_MODEL_DEVICE=cpu
LITERATURE_MAX_PDF_MB=50
LITERATURE_MAX_PDF_PAGES=500
LITERATURE_EMBEDDING_REVISION=

# Set intern only after the model endpoint has been checked.
LLM_PROVIDER=mock
INTERN_BASE_URL=https://chat.intern-ai.org.cn/api/v1/
INTERN_MODEL=intern-s2-preview-35b
INTERN_API_KEY=
INTERN_THINKING_MODE=true
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=4096
